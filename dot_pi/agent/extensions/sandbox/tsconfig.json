{
	"compilerOptions": {
		"strict": true,
		"noEmit": true,
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"target": "esnext",
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"esModuleInterop": true,
		"outDir": "dist",
		"types": ["node"]
	},
	"include": ["*.ts"],
	"exclude": ["node_modules", "dist"]
}
